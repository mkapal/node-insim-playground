{
  "name": "node-insim-playground",
  "version": "0.0.1",
  "description": "Node InSim Playground",
  "main": "index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mkapal/node-insim-playground.git"
  },
  "author": "Martin Kapal <flamecze@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start:insim": "tsx watch src/insim/index.tsx",
    "start:outgauge": "tsx watch src/outgauge/index.tsx",
    "build:insim": "tsup src/insim/index.tsx",
    "build:outgauge": "tsup src/outgauge/index.tsx",
    "format": "prettier --write \"./**/*.{js,ts,md,json,yml,yaml}\"",
    "lint": "eslint \"./src/**/*\" --ext .js,.ts",
    "lint:fix": "eslint \"./src/**/*\" --ext .js,.ts --fix",
    "tsc": "tsc"
  },
  "dependencies": {
    "debug": "^4.4.1",
    "dotenv": "^17.2.2",
    "node-insim": "6.6.0",
    "react": "^19.2.8",
    "react-node-insim": "^0.4.0",
    "supports-color": "^10.2.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^24.3.1",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "8.42.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts"
  ],
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
